# OS / editor cruft
Thumbs.db
.DS_Store

# Secrets
.env

# Operational config (non-secret, machine-specific) -- see .env.config.example
.env.config

.venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.ruff_cache/

# CI checks out the sibling pr-review-bot repo here (see
# .github/workflows/ci.yml and tests/test_cross_repo_config_ordering.py) --
# never this repo's own content.
/pr-review-bot/

# Local session state (machine-specific, not shared)
memory.md
auth-link.txt

# Local git worktrees (superpowers subagent-driven-development scratch)
.worktrees/
.claude/worktrees/

# Personal/local Claude Code permission overrides -- not meant to be shared
.claude/settings.local.json

# Impeccable process scratch -- transient, regenerated per design/review
# pass (decision-round and comp images, build-phase state, question-page
# logs, finish-review screenshot evidence); stale copies in git would be
# actively misleading rather than useful history. Config/surface-brief/
# design-system state under .impeccable/ is still tracked (matches the
# sibling review-engine project's own .impeccable/.gitignore convention).
.impeccable/mocks/
.impeccable/build/
.impeccable/questions/
.impeccable/review/
.impeccable/hook.cache.json
