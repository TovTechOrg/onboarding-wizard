# Test suite and fixtures aren't needed by the running service -- the
# Dockerfile only ever `uv sync`/runs the package itself.
**/tests/
**/__pycache__/
*.pyc

# Never let a build context pick up local secrets or machine-specific config
# even though .dockerignore is a second, redundant safety net alongside
# .gitignore and the git-tracked-files-only build context most CI setups use.
.env
**/.env
.env.config
**/.env.config
*.pem
gcp-service-account-key*.json

.git/
.venv/
docs/superpowers/

# update_bot_contract.py is a developer command the running service never
# invokes -- same reasoning as **/tests/ above.
scripts/

# contracts/provisioning.json is NOT dev-only anymore (2026-09-12): router.py
# reads it at import time (the Vertex location allowlist, served by
# GET /api/llm/vertex/locations and enforced by every endpoint that accepts
# a location) -- see router.py's _CONTRACT/_VERTEX_LOCATIONS. Excluding all
# of contracts/ here left main.py unable to import at all in the built
# image (verified live: `docker run ... python -c "import main"` raised
# FileNotFoundError), since .dockerignore silently wins over anything
# COPY . . would otherwise include. Only the one file the service actually
# reads is un-ignored below -- a future dev-only addition to contracts/
# stays excluded by default.
contracts/
!contracts/provisioning.json

# `.env` does not match `.env.example`.
.env.example

# Local agent/tooling config, never part of the service.
.claude/
.impeccable/

# Any service-account / private-key JSON, whatever it is named. None exists
# in this repo today; the narrow `gcp-service-account-key*.json` pattern
# alone missed a real file in the sibling repo.
*private-key*.json
*service-account*.json
